                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n    e.measured_at AS \"Czas pomiaru\",\r\n    e.room_id AS \"Chłodnia\",\r\n    e.batch_id AS \"Partia\",\r\n    b.meal_name AS \"Posiłek\",\r\n    b.portions AS \"Porcje\",\r\n    e.temperature_c AS \"Temperatura (°C)\",\r\n    e.threshold_c AS \"Próg (°C)\"\r\nFROM public.temperature_excursions AS e\r\nLEFT JOIN public.batches AS b ON b.batch_id = e.batch_id\r\nWHERE $__timeFilter(e.measured_at)\r\nORDER BY e.measured_at DESC;",
